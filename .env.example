# PostgreSQL Database Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git!

# Database connection URL format:
# postgresql+psycopg2://username:password@host:port/database_name
RESEARCH_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/cs2_research

# Optional: Alternative database names for different environments
# DEV_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/cs2_research_dev
# TEST_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/cs2_research_test
